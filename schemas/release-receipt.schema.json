{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalar.atelier/story-bible/1.2/release-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectRef", "releaseId", "sourceCommit", "createdAt", "rightsBasis", "headReceiptSha256", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectRef": { "type": "string", "minLength": 1, "maxLength": 128 },
    "releaseId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "createdAt": { "$ref": "https://scalar.atelier/story-bible/1.0/common.json#/$defs/timestamp" },
    "rightsBasis": { "$ref": "https://scalar.atelier/story-bible/1.0/common.json#/$defs/rightsBasis" },
    "headReceiptSha256": { "$ref": "https://scalar.atelier/story-bible/1.0/common.json#/$defs/sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "$ref": "https://scalar.atelier/story-bible/1.0/common.json#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 20000000 }
        }
      }
    }
  }
}
