{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalar.atelier/story-bible/1.2/anchor-ack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "anchors"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchorId", "receiptSha256", "receivedAt", "keyId", "hmac"],
        "properties": {
          "anchorId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "receiptSha256": { "$ref": "https://scalar.atelier/story-bible/1.0/common.json#/$defs/sha256" },
          "receivedAt": { "$ref": "https://scalar.atelier/story-bible/1.0/common.json#/$defs/timestamp" },
          "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "hmac": { "$ref": "https://scalar.atelier/story-bible/1.0/common.json#/$defs/sha256" }
        }
      }
    }
  }
}
