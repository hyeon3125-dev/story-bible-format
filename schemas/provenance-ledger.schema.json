{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalar.atelier/story-bible/1.2/provenance-ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectRef", "events"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectRef": { "type": "string", "minLength": 1, "maxLength": 128 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provenance-event.schema.json" }
    }
  }
}
