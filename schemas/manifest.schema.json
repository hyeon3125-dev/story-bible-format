{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://scalar.atelier/story-bible/1.0/manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "title", "generatedAt", "sourceHashes", "outputHashes", "contextTarget"],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0"] }, "projectId": { "type": "string" }, "title": { "type": "string" }, "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "sourceHashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "outputHashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "contextTarget": { "enum": [16000, 32000, 64000, 128000] }
  }
}
